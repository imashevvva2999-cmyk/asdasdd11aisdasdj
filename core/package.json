{
  "name": "@mmusic/core",
  "version": "0.1.0",
  "private": true,
  "description": "Shared Mmusic logic for the Expo app and the Vite website: pure TypeScript only — no React Native, Expo, DOM components or bundled assets",
  "sideEffects": false,
  "exports": {
    "./constants/*": "./constants/*.ts",
    "./lib/*": "./lib/*.ts",
    "./mocks": "./mocks/index.ts",
    "./mocks/*": "./mocks/*.ts",
    "./platform/*": "./platform/*.ts",
    "./audio/*": "./audio/*.ts",
    "./demo/*": "./demo/*.ts",
    "./promotion/*": "./promotion/*.ts",
    "./state/*": "./state/*.ts",
    "./package.json": "./package.json"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "check:boundaries": "node scripts/verify-boundaries.mjs",
    "test": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/verify-storage.mjs"
  },
  "peerDependencies": {
    "react": "^19.2.0",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@types/react": "19.2.18",
    "react": "19.2.3",
    "typescript": "~5.7.3",
    "zustand": "5.0.15"
  }
}
