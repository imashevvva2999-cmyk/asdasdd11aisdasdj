{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": ["react", "typescript", "jsx-a11y", "import"],
  "categories": { "correctness": "error" },
  "rules": {
    "react/rules-of-hooks": "error",
    "react/exhaustive-deps": "warn",
    "no-restricted-imports": [
      "error",
      {
        "patterns": [
          {
            "group": ["react-native", "react-native/*", "react-native-*", "@react-native/*", "expo", "expo/*", "expo-*", "@expo/*"],
            "message": "apps/web must not depend on React Native or Expo."
          },
          {
            "group": ["**/apps/mobile/**", "@mmusic/mobile", "@mmusic/mobile/*"],
            "message": "Do not import from the Expo app; use shared packages."
          }
        ]
      }
    ]
  },
  "ignorePatterns": ["dist"]
}
