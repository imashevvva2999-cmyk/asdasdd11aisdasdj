{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": ["react", "typescript", "jsx-a11y", "import"],
  "categories": { "correctness": "error" },
  "rules": {
    "react/rules-of-hooks": "error",
    "react/exhaustive-deps": "warn",
    "no-restricted-imports": [
      "error",
      {
        "patterns": [
          {
            "group": ["react-native", "react-native/*", "react-native-*", "@react-native/*", "expo", "expo/*", "expo-*", "@expo/*"],
            "message": "CRM must not depend on React Native or Expo."
          },
          {
            "group": ["**/apps/mobile/**", "**/apps/web/**", "**/apps/arm/**", "@mmusic/mobile", "@mmusic/mobile/*", "@mmusic/web", "@mmusic/web/*", "@mmusic/arm", "@mmusic/arm/*"],
            "message": "CRM is independent: share code only through @mmusic/backoffice or @mmusic/ui-kit."
          }
        ]
      }
    ]
  },
  "ignorePatterns": ["dist"]
}
