# Mmusic — environment variable template. Copy to .env and fill in real values.
# NEVER commit a real .env file (already in .gitignore).

# --- apps/api ---
PORT=3000
NODE_ENV=development
DATABASE_URL=postgresql://mmusic:mmusic@localhost:5432/mmusic
REDIS_URL=redis://localhost:6379

# --- MBANK integration (OQ-02, OQ-07, OQ-44, OQ-53) ---
# No real MBANK API/sandbox credentials exist yet (OQ-44). Until they are provided,
# any auth/payments integration must run against a clearly-labeled local mock —
# never treat these values as a real integration just because they are set.
MBANK_MOCK_MODE=true
MBANK_IDP_ISSUER_URL=
MBANK_IDP_CLIENT_ID=
MBANK_IDP_CLIENT_SECRET=
MBANK_PAYMENTS_BASE_URL=
MBANK_PAYMENTS_API_KEY=

# --- Object storage / CDN (architecture.md §3.1) ---
S3_ENDPOINT=
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
CDN_BASE_URL=
