{
  "name": "@mmusic/backoffice",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Shared foundation for the Mmusic back-office apps (ARM, CRM): domain types, permissions, RU/EN strings, clearly labelled mock data with safe browser persistence, and the responsive application shell. DOM-only; never imported by the public website or the mobile app.",
  "exports": {
    "./domain": "./src/domain.ts",
    "./storage": "./src/storage.ts",
    "./rbac": "./src/rbac.ts",
    "./session": "./src/session.ts",
    "./review": "./src/review.ts",
    "./i18n": "./src/i18n.ts",
    "./data": "./src/data.ts",
    "./mocks": "./src/mocks.ts",
    "./react": "./src/react.tsx",
    "./ui": "./src/ui/index.tsx",
    "./package.json": "./package.json"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "lint": "oxlint --type-aware src tests scripts",
    "test": "node --test --disable-warning=MODULE_TYPELESS_PACKAGE_JSON tests/*.test.ts",
    "check:boundaries": "node scripts/verify-boundaries.mjs"
  },
  "dependencies": {
    "@mmusic/ui-kit": "workspace:*"
  },
  "peerDependencies": {
    "react": "^19.2.0",
    "react-router": "^7.18.0",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@types/node": "24.19.1",
    "@types/react": "19.2.18",
    "oxlint": "1.86.0",
    "oxlint-tsgolint": "7.0.2003",
    "react": "19.2.3",
    "react-router": "7.18.4",
    "typescript": "6.0.3",
    "zustand": "5.0.15"
  }
}
